#!/bin/sh
# Remove what ./install put in place (other files in those folders are kept).
set -eu
data=${XDG_DATA_HOME:-$HOME/.local/share}
rm -f "$HOME/.local/bin/mzp" "$HOME/.local/lib/mzp/libpdfium.so" "$data/applications/mzp.desktop" \
	"$data/icons/hicolor/scalable/apps/mzp.svg" "$data/mzp/licenses/FONT-OFL.txt" "$data/mzp/licenses/RAYLIB-LICENSE.txt"
rm -rf "$data/mzp/licenses/pdfium"
rmdir "$HOME/.local/lib/mzp" "$data/mzp/licenses" "$data/mzp" 2>/dev/null || true
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
[ -f "$data/icons/hicolor/icon-theme.cache" ] && command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$data/icons/hicolor" || true
echo "Uninstalled mzp (settings in ~/.config/mzp are kept)."
